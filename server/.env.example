# Copy to server/.env. Leave optional fields empty until configured.
# All credentials are SERVER ONLY. Never use VITE_ for any provider/private key.
PORT=3000
APP_ORIGIN=http://localhost:5173
# Optional additional EXACT frontend origins, comma-separated. No wildcard or paths.
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Production requires NODE_ENV=production and an HTTPS APP_ORIGIN.
# NODE_ENV=production
# Optional for institution/corporate TLS proxies using roots already trusted by your OS.
# Requires modern Node with TLS CA APIs (verified on Node24.12). Never disable TLS checks.
# ENCORE_USE_SYSTEM_CA=true
# ENCORE_DB=./data/encore.db
# ENCORE_TICKET_IMAGE_DIR=./data/ticket-images
# TRUST_PROXY=loopback

# Ticketmaster Discovery: registered Consumer Key (not Consumer Secret).
TICKETMASTER_API_KEY=
TICKETMASTER_DAILY_LIMIT=100
TICKETMASTER_MIN_INTERVAL_MS=1000
TICKETMASTER_MAX_PAGES=3
CONCERT_CACHE_TTL_MS=900000
CONCERT_SYNC_INTERVAL_MS=21600000

# OneMap: register an account. Email/password enables automatic token refresh.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
# Alternative: manually generated short-lived token (refresh locally when expired).
ONEMAP_TOKEN=
ONEMAP_DAILY_LIMIT=1000

# LTA DataMall: Account Key issued after registration.
LTA_ACCOUNT_KEY=
LTA_DAILY_LIMIT=1000

# NEA via data.gov.sg works without a key at public limits.
DATA_GOV_SG_API_KEY=

# SMTP you already have: port587 STARTTLS or465 TLS. No paid service is selected.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Run npm run push:keys once. Only VAPID_PUBLIC_KEY is sent to the browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:replace-with-your-contact@example.com
ENABLE_BACKGROUND_JOBS=true
# Maximum idle/crash reconciliation interval; successful mutations wake jobs immediately.
BACKGROUND_JOB_INTERVAL_MS=60000
